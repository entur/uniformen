ENVIRONMENT=dev

AUTH0_INTERNAL_AUDIENCE=https://api.dev.entur.io
AUTH0_INTERNAL_ISSUER=https://internal.dev.entur.org/
AUTH0_INTERNAL_JWKS_URI=https://internal.dev.entur.org/.well-known/jwks.json
AUTH0_INTERNAL_USERINFO_URI=https://internal.dev.entur.org/userinfo

AUTH0_PARTNER_AUDIENCE=https://api.dev.entur.io,https://portal.dev.entur.org
AUTH0_PARTNER_ISSUER=https://partner.dev.entur.org/
AUTH0_PARTNER_JWKS_URI=https://partner.dev.entur.org/.well-known/jwks.json
AUTH0_PARTNER_USERINFO_URI=https://partner.dev.entur.org/userinfo

NOTIFICATION_API_BASE_URI=https://api.dev.entur.io/notification-center

# Optional. The project API key of the PostHog project, which starts with phc_.
# Without it, the AI agent feature flag is off for everyone.
# POSTHOG_API_KEY=

# Optional. Needed to test the AI agent chat locally. Without all four values,
# chat is off and the server logs "Chat is off. Missing env vars".
# SPORAI_URL=
# AUTH0_INTERNAL_TOKEN_URI=https://internal.dev.entur.org/oauth/token
# MNG_AUTH0_INT_CLIENT_ID=
# MNG_AUTH0_INT_CLIENT_SECRET=
